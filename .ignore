# Search-noise filter (owner-set 2026-10-01).
# Everything listed here stays on disk and opens fine by path. It is only hidden
# from default repo search (ripgrep, so Claude's Grep and Glob), so a search
# returns current work instead of copies, bundles and finished-work records.
# Same list: .cursorindexingignore (Cursor) and ignored_paths in .serena/project.yml.
# To search everything anyway: rg --no-ignore-dot <pattern>

# Third-party and generated bundles, minified, served as-is by the live site
public/vendor/
public/climate/_next/

# Page draft, share and backup copies. The live page source is the file outside preview/.
marketing/landing-pages/**/preview/*.html
marketing/landing-pages/**/preview/shareable-*/
marketing/landing-pages/slo/archived/
marketing/landing-pages/**/*.before*.html

# Copies of pages taken at push time
ops/workflows/cf-push-snapshots/

# Finished-work records: archived boards, proof folders, scratch scripts
# (the *-evidence/ proof folders are already hidden by .gitignore)
ops/workflows/archive/
ops/workflows/*-prove-*/
ops/workflows/*-proof-*/
ops/workflows/live-prove-*/
ops/workflows/w10-pack-*/
ops/workflows/blueprint-portal-screens-*/
ops/workflows/expected-deliverables-*/
scripts/tmp/


# This cleanup's own data dump
ops/workflows/repo-restructure-2026-10-01/*.tar.gz

# This cleanup's archived instruction copies
ops/archive/ai-instructions-2026-10-24/
