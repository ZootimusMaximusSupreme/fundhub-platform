# Local development template. Copy to .env and fill in.
# Production reads the same names from Netlify. When you change one, change both.
# Never commit .env.

# Postgres (local or pooler). Production DATABASE_URL is set only in Netlify.
DATABASE_URL=
# Admin/owner URL for migrations (fundhub_app cannot alter schema).
MIGRATION_DATABASE_URL=

# Agent runtime (src/agents/model.mjs). Unset = shadow mode (logs, sends nothing).
ANTHROPIC_API_KEY=

# Oxylabs residential Apply door (src/adapters/oxylabs.mjs).
# Username WITHOUT the customer- prefix — the adapter adds it.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Resend outbound email (src/messaging/providers/resend.mjs). Default after migration 164.
RESEND_API_KEY=
RESEND_FROM=
# Optional override; defaults to https://api.resend.com
# RESEND_BASE_URL=

# PostGrid print-and-mail (src/messaging/providers/mail-letter.mjs). USPS only.
POSTGRID_API_KEY=
POSTGRID_WEBHOOK_SECRET=

# Mailgun outbound email (src/messaging/providers/mailgun.mjs). Kept for legacy; not the default.
MAILGUN_SEND_API_KEY=
MAILGUN_SEND_DOMAIN=
MAILGUN_SEND_FROM=
# Optional EU region: https://api.eu.mailgun.net
# MAILGUN_SEND_BASE_URL=

# CRM / LeadConnector — outbound SMS removed (owner 2026-08-14). Stub only.
# Contact sync may still read these; do not use for send.
GHL_API_KEY=
GHL_RELAY_API_KEY=

# Document download link signing.
DOCUMENT_URL_SECRET=

# Encrypts partner OAuth tokens at rest (AES-256-GCM). Generate: openssl rand -base64 32
AD_TOKEN_ENC_KEY=

# Encrypts SSN / PII at rest. Separate from AD_TOKEN_ENC_KEY on purpose.
PII_ENC_KEY=

# Sole producer of round.started / round.submitted / round.approved / round.funded.
LENDFLOW_WEBHOOK_SECRET=
LENDFLOW_API_KEY=

# Prove destinations for agents (local prove scripts only — not read by Netlify handlers).
# Use a plus-tag on your real inbox so mail lands without colliding with a live client file.
FUNDHUB_TEST_INBOX=
FUNDHUB_TEST_PHONE=

# Twilio — inbound webhooks vs outbound send use separate tokens (do not merge).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SEND_ACCOUNT_SID=
TWILIO_SEND_AUTH_TOKEN=
TWILIO_SEND_FROM=

# Fundhub public SMS / voice line (also shown in outbound email footers).
FUNDHUB_REP_NUMBER=
EXPERIAN_DISPUTE_NUMBER=+18554146048
EQUIFAX_DISPUTE_NUMBER=+18665495097
TRANSUNION_DISPUTE_NUMBER=+18009168800
BLAND_VOICE=mason

# Creative Factory provider keys (fundhub-level — never partner-supplied).
CREATIVE_STATIC_API_KEY=
CREATIVE_UGC_API_KEY=
CREATIVE_PRODUCT_VIDEO_API_KEY=
CREATIVE_COPY_API_KEY=
CREATIVE_RESIZE_API_KEY=

# Ad platform API versions (pinned).
META_API_VERSION=v26.0
# Meta Marketing API — system user token (Business Manager → System users). Required for CTR/spend sync.
# META_ACCESS_TOKEN=
# META_BUSINESS_ID=
# META_AD_ACCOUNT_ID=act_
TIKTOK_API_VERSION=v1.3

# LinkedIn Talent Solutions API version.
LINKEDIN_API_VERSION=202405

# Postgres client tuning (defaults in src/db.mjs).
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# DO NOT set locally unless you intend to wake production workflow fans-out.
# Owner gate — flipping this on Netlify wakes 47 Inngest functions.
# INNGEST_EVENT_KEY=

# Company Brain / Meet recordings. Files stay in Google Drive; Fundhub stores the link.
# Personal Google OAuth (desktop token from file-sweep) — Drive + Gmail share this file.
# GOOGLE_GMAIL_OAUTH_TOKEN_PATH=~/file-sweep/credentials/token.json
# GOOGLE_GMAIL_OAUTH_TOKEN_JSON=
# GOOGLE_OAUTH_TOKEN_PATH=~/file-sweep/credentials/token.json
# GOOGLE_OAUTH_TOKEN_JSON=
# Company Brain Drive (falls back for Gmail when gmail vars unset):
# GOOGLE_DRIVE_OAUTH_TOKEN_PATH=~/file-sweep/credentials/token.json
# GOOGLE_DRIVE_OAUTH_TOKEN_JSON=
# Workspace service account (production default):
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_DELEGATE_EMAIL=

# Post-funding interview — funding advisor sends this after round.funded.
# INSIGHT_MEET_BOOKING_URL=https://apply.fundhub.ai/funding-book-call
# Sales strategy session — default is apply.fundhub.ai/funding-book-call if unset.
# SALES_MEET_BOOKING_URL=https://apply.fundhub.ai/funding-book-call

# CRS soft pull. Owner 2026-08-24: TransUnion on (same prequal FICO 9 as EX/EQ).
# Unset = TU,EX,EQ. Override example: CRS_ACTIVE_BUREAUS=TU,EX,EQ
# CRS_ACTIVE_BUREAUS=TU,EX,EQ

# SLO ClickFunnels post-purchase (CF slo_ref stamp, CSM chase, 30-day $32 skip).
# Unset = off. true / 1 / yes turns it on.
# SLO_POST_PURCHASE_ENABLED=

# Lending Climate Engine (public lead magnet at /climate/).
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# BLS optional (public API works without it, higher rate with it):
# BLS_API_KEY=
# Google Maps (Places + Geocoding). Restrict the browser key to https://fundhub.ai/*
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_BROWSER_KEY=

# Smart Credit / ConsumerDirect Enrollment Widget (hidden /optimize page).
# Both names must exist or the widget stays hidden. Do not invent values.
# CONSUMER_DIRECT_CLIENT_KEY=
# CONSUMER_DIRECT_PID=
# Optional aliases: SMART_CREDIT_CLIENT_KEY=  SMART_CREDIT_PID=
# CONSUMER_DIRECT_ENV=production
# CONSUMER_DIRECT_ENV=stage

# Daily pulse SMS to Chris. E.164. Netlify secret. Do not commit the number.
# PULSE_SMS_TO=
# CHRIS_PULSE_SMS=
# Finished-ad text only. E.164. Netlify secret. Do not commit the number.
# When set, this wins over PULSE_SMS_TO for that one text.
# AD_VIDEO_SMS_TO=
# Extra Blake From address if his inbox changes. Default is already in code
# from prove Gmail (do not invent a public inbox here).
# BLAKE_FROM_EMAIL=
# Daily pulse Darwin ticket (WhatsApp). Unset = write the ticket, skip send.
# E.164 only (+ and digits). Do not invent a number.
# DARWIN_WHATSAPP=
# Optional. Where the pulse writes pulse-YYYY-MM-DD.md. Default: docs/workflows
# PULSE_BOARD_DIR=

# Gate relay (scripts/gate-relay). Mac process — not a Netlify function.
# Telegram is the current phone channel. Twilio SMS is the eventual channel; not wired.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_CHAT_ID=
# Whisper for voice notes. Company Brain also reads this name.
OPENAI_API_KEY=

# RB2B identified-visitor webhook (api/public/rb2b-webhook.mjs).
# Paste into RB2B as: https://fundhub.ai/api/public/rb2b-webhook?secret=<this>
# RB2B documents no signature — secret is the query param only.
# RB2B_WEBHOOK_SECRET=
# Public pixel id (also baked into public/funnel/rb2b.js). Not a secret.
# RB2B_ID=

# ClickFunnels 2.0 API — Custom HTML Pages push (scripts/cf-push-custom-html.mjs).
# CLICKFUNNELS_API_KEY=
# CLICKFUNNELS_SUBDOMAIN=chrisstanbridgestea3f77f
# CLICKFUNNELS_WORKSPACE_ID=
# Custom /apply survey browser POSTs (X-Fundhub-Apply-Survey-Ingest). Not the CF webhook HMAC secret.
# CLICKFUNNELS_APPLY_SURVEY_INGEST_SECRET=
# Meta pixel for custom HTML document head (optional — repo ground truth if unset).
# META_PIXEL_ID=
# Microsoft Clarity (optional — leave unset to skip).
# CLARITY_PROJECT_ID=
# GA4 measurement id (optional — leave unset to skip). Shape G-XXXXXXXX.
# GA_MEASUREMENT_ID=

# GitLab full-repo backup (scripts/gitlab-push-whole-repo.mjs). See .claude/rules/gitlab-push.md
# GITLAB_PROJECT=fundhub-llc-group/fundhub-llc-project
# Push: personal/project/group access token with write_repository in GITLAB_TOKEN; leave GITLAB_DEPLOY_USERNAME unset.
# Read-only clone: deploy token username + token (read_repository only — cannot push).
# GITLAB_DEPLOY_USERNAME=
GITLAB_TOKEN=
