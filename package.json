{
  "name": "fundhub-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Fundhub custom platform — Postgres + event bus replacing the old CRM and spreadsheet. Master Rebuild Spec v1.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "migrate": "node db/migrate.mjs",
    "ship": "node scripts/ship.mjs",
    "migrations:manifest": "node scripts/db/expected-migrations.mjs",
    "artifact": "node scripts/build-artifact.mjs",
    "diagrams": "node scripts/diagrams/generate.mjs",
    "diagrams:check": "node scripts/diagrams/generate.mjs --check",
    "ads:check": "node scripts/ads/check-script.mjs",
    "journeys": "node scripts/journeys/generate.mjs",
    "journeys:check": "node scripts/journeys/generate.mjs --check",
    "test": "node scripts/run-suite.mjs",
    "guard:db": "node --test src/security/superuser-guard.test.mjs",
    "guard:rls": "node --test src/security/rls-shape.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.mjs",
    "verify:e2e": "node scripts/run-e2e-verification.mjs",
    "sim:report": "node scripts/purge-sim-data.mjs report",
    "sim:hide": "node scripts/purge-sim-data.mjs flag",
    "sim:purge": "node scripts/purge-sim-data.mjs delete",
    "gate-relay": "node scripts/gate-relay/index.mjs",
    "notion:login": "NOTION_HEADFUL=1 node scripts/notion-legacy-pull.mjs --login",
    "notion:pull": "node scripts/notion-legacy-pull.mjs --pull",
    "notion:transcribe": "node scripts/notion-legacy-transcribe.mjs",
    "notion:organize": "node scripts/notion-legacy-organize.mjs",
    "notion:vimeo": "node scripts/notion-vimeo-watch.mjs",
    "notion:retry": "node scripts/notion-retry-failed.mjs",
    "notion:captions": "node scripts/notion-vimeo-captions.mjs",
    "notion:sweep": "node scripts/notion-final-sweep.mjs",
    "notion:finish": "node scripts/notion-finish-pass.mjs",
    "notion:files": "node scripts/notion-pull-files.mjs",
    "notion:resume": "node scripts/notion-resume-pull.mjs",
    "notion:verify": "node scripts/notion-legacy-verify.mjs",
    "notion:all": "node scripts/notion-legacy-all.mjs",
    "lenders:audit": "node scripts/lenders-audit/run.mjs",
    "lenders:audit:apply": "node scripts/lenders-audit/apply-manifest.mjs",
    "flywheel:status": "node scripts/flywheel/status.mjs",
    "marketing:run-queue": "node scripts/marketing-run-queue.mjs",
    "marketing:data:health": "node scripts/marketing-data-health.mjs",
    "marketing:data:bootstrap": "node scripts/marketing-data-bootstrap.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.11",
    "@pdf-lib/fontkit": "^1.1.1",
    "inngest": "^3.21.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "ffmpeg-static": "^5.3.0"
  }
}
