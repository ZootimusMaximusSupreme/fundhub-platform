# Netlify response headers. https://docs.netlify.com/routing/headers/
#
# WHY THIS FILE EXISTS
#
# On 2026-07-31 every /app/ screen bounced back to command-center.html in
# production while main was correct and deployed. The cause was a stale cached
# copy of /app/shell.js: it predated 0db4bce, which added campaign-manager.html
# and hiring.html to the gate's ALL list, so the gate did not recognise those
# two screens, `ok.indexOf(PAGE) === -1` was true at shell.js:483, and line 486
# sent the browser to HOME[role]. Reproduced exactly by serving the pre-0db4bce
# shell.js against an unmodified server: the two new screens bounced, the older
# ones did not.
#
# Nothing was version-stamped and nothing said how long to cache. Every screen
# loads `<script src="shell.js">` — no query string, no content hash — and there
# was no _headers file and no [[headers]] block in netlify.toml. With no
# explicit Cache-Control, a cache is free to apply heuristic freshness (a
# fraction of the time since Last-Modified), so an old shell.js can be served
# for a long time after a deploy and no amount of redeploying dislodges it.
#
# The alternative fix was to version the reference — shell.js?v=<sha> — but that
# means editing every screen on every change and keeping 24 files in step, and a
# single missed file reintroduces the bug silently. One rule here covers every
# screen, including ones added later, and covers data.js, which has exactly the
# same exposure and would have been missed by a shell.js-only fix.
#
# WHAT THIS DOES NOT DO
#
# It does not disable caching. `max-age=0, must-revalidate` still lets the
# browser keep the file and still lets Netlify answer a revalidation with 304 —
# the request is cheap and the payload is not re-sent. What it removes is a
# cache's freedom to serve a stale copy WITHOUT asking. That is the property
# this app needs, because the gate is the first thing that runs and a stale gate
# decides against a screen it has never heard of.
#
# If a content-hashed build ever lands here, hashed filenames should get
# `immutable` instead and this rule should narrow to the unhashed entry points.

# The CRM shell and its data layer. Unversioned, and the gate lives here.
/app/*.js
  Cache-Control: public, max-age=0, must-revalidate

# The screens themselves. Same reasoning: an old screen can reference a script
# or an endpoint that no longer matches the deployed API.
/app/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The login page decides where an unauthenticated visitor goes, and it writes
# the session the gate then reads. A stale one strands people outside the app.
/login.html
  Cache-Control: public, max-age=0, must-revalidate

# The contract signing page. Same rule for the same reason as the screens above —
# a stale copy can talk to an endpoint shape that no longer exists — plus one
# that is specific to this page: a document somebody is about to SIGN must never
# be served from a cache. The words are fetched fresh on every load
# (/api/contracts/sign answers no-store), and the page that fetches them must be
# fresh too.
/contract.html
  Cache-Control: public, max-age=0, must-revalidate

# VSL on apply.fundhub.ai/vsl. Must be video/mp4 with no attachment header
# so Chrome will autoplay it muted on mobile.
/funnel/vsl.mp4
  Content-Type: video/mp4

# Client portal welcome video. content_videos.storage_key points here, and the
# signed /api/content/welcome-video link 302s to it, so the browser's <video>
# element fetches this file directly and needs the same content type.
/assets/video/portal-welcome.mp4
  Content-Type: video/mp4

# Unhashed CRM styles must revalidate just like their HTML and JavaScript.
/app/*.css
  Cache-Control: public, max-age=0, must-revalidate

/portal-login.html
  Cache-Control: public, max-age=0, must-revalidate

/progress.html
  Cache-Control: public, max-age=0, must-revalidate

/reset-password.html
  Cache-Control: public, max-age=0, must-revalidate

# The /thank-you App Store card (public/funnel/fundhub-prompter-download.js) runs on
# apply.fundhub.ai and reads its link from this file on fundhub.ai. Without this
# header the browser blocks the read and the card never draws.
/funnel/fundhub-prompter-download.json
  Access-Control-Allow-Origin: https://apply.fundhub.ai

# The phone slideshows at /slideshows/<name>/ (public/slideshows/<name>/index.html). Booked leads get a text or an
# email that links to one, and the page is rewritten whenever a deck changes (node marketing/slideshows/build.mjs
# --publish). Same reason as the screens above: a cache must ask before it serves one, or a lead opens last week's
# words. Each page is one self-contained file (its own styles, script and pictures are inside it), so this one rule
# covers the whole page.
/slideshows/*
  Cache-Control: public, max-age=0, must-revalidate
