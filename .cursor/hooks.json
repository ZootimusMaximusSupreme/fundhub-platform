{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/warn-secret-stage.cjs",
        "matcher": "git\\s+(add|commit|stage|rm|mv)\\b",
        "failClosed": false
      },
      {
        "command": "node scripts/hooks/guard-new-markdown.mjs",
        "matcher": "\\.md\\b",
        "failClosed": false
      },
      {
        "command": "node scripts/hooks/guard-overlay-schedule.mjs",
        "matcher": "build-from-schedule",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "node scripts/hooks/guard-new-markdown.mjs",
        "matcher": "Write|Edit|TabWrite",
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "but cursor after-edit"
      },
      {
        "command": "node scripts/hooks/guard-overlay-schedule.mjs"
      }
    ],
    "stop": [
      {
        "command": "but cursor stop"
      }
    ]
  }
}
